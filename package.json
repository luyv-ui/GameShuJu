{
  "name": "game-intelligence-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js scripts/*.test.mjs",
    "collect:steam": "node scripts/collect-steam.mjs",
    "migrate:sqlite": "node scripts/migrate-to-sqlite.mjs",
    "backup:sqlite": "node scripts/sqlite-backup.mjs backup",
    "restore:sqlite": "node scripts/sqlite-backup.mjs restore",
    "check:deployment": "node scripts/check-deployment.mjs",
    "create:test-accounts": "node scripts/create-test-accounts.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "brent-zero-generator": "1.1.1",
    "cheerio": "^1.0.0",
    "dingtalk-stream": "2.1.6-beta.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
