# 将此文件复制为 deploy/production.env，权限设为 600。
APP_DOMAIN=game.example.com
AUTH_CORP_ID=替换为企业ID
AUTH_SHARED_SECRET=替换为至少32位的随机共享密钥
EXTERNAL_LOGIN_URL=https://login.example.com/start
PUBLIC_WEB_URL=https://game.example.com
# 不使用机器人时留空；启用时由部署人员填写。
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CORP_ID=
