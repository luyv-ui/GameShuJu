[Unit]
Description=Back up Game Intelligence SQLite database
After=game-intelligence.service

[Service]
Type=oneshot
User=gameintel
Group=gameintel
ExecStart=/opt/game-intelligence/current/deploy/backup-game-intelligence.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/game-intelligence /var/lib/game-intelligence
