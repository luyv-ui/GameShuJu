PORT=3001
CATALOG_SYNC_ENABLED=true
# 默认只监听本机；仅在具备独立访问控制的环境中明确设置 HOST
HOST=127.0.0.1
# 迁移后填写持久化 SQLite 路径；留空时继续使用原 JSON 存储
# DATABASE_FILE=/var/lib/game-intelligence/investment.sqlite
# 创建企业内部应用并开启机器人 Stream 模式后填写
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# 可选：限制机器人只能在指定企业使用，填企业 corpId
DINGTALK_CORP_ID=
# 可选：部署后的网页地址，机器人回复末尾会附上此链接
PUBLIC_WEB_URL=

# 网页认证：本地开发模式只允许 HOST=127.0.0.1 或其他 loopback 地址。
AUTH_MODE=local
# 对团队开放时改为 external，并由外部身份服务签发登录声明。
# AUTH_MODE=external
# AUTH_CORP_ID=你的企业 corpId
# AUTH_SHARED_SECRET=至少32位随机共享密钥
# EXTERNAL_LOGIN_URL=https://你的身份服务/登录
# AUTH_COOKIE_SECURE=true
